# AgentsAlignmentBox settings. Copy to .env (or run ./setup.sh) and fill in.
# Everything is optional except a way to log in over SSH (a key or a password).

# --- SSH access (sandbox: port 2222, user agent; monitor: port 2223, user monitor) ---
# One or more public keys, separated by ';' (./setup.sh fills in ~/.ssh/id_*.pub).
AAB_SSH_PUBKEY=
# Or / and a password (key login is safer).
AAB_SSH_PASSWORD=

# --- Agents in the sandbox ---
# Leave empty to log in from the sandbox with your subscription (`claude` then /login,
# `codex login --device-auth`). Set them to bill API keys instead.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
OPENAI_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# --- Monitor ---
# claude-code: headless Claude Code on your Claude Pro / Max plan (log in once over SSH,
#              or set MONITOR_CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`)
# api:         Anthropic API, billed to MONITOR_ANTHROPIC_API_KEY
# rules-only:  deterministic rules, no model
MONITOR_BACKEND=claude-code
MONITOR_MODEL=sonnet
# MONITOR_CLAUDE_CODE_OAUTH_TOKEN=
# MONITOR_ANTHROPIC_API_KEY=
# MONITOR_API_MODEL=claude-opus-5-5
# Review on every new activity (activity) or only when a rule fires (signals).
MONITOR_TRIGGER=activity
MONITOR_INTERVAL_S=60
# Stop agents automatically on flags of this severity or above: off | critical | high | medium
MONITOR_AUTO_KILL=off
# Tabular model scoring every tool call on CPU: tabpfn (TabPFN v2) | trees (scikit-learn) | off
MONITOR_TABULAR=tabpfn
MONITOR_TABULAR_THRESHOLD=0.6

# --- Dashboard ---
# Optional HTTP basic-auth password (any user name).
AAB_WEB_PASSWORD=

# --- Ports and versions ---
# AAB_BIND=127.0.0.1
# AAB_SSH_PORT=2222
# AAB_MONITOR_SSH_PORT=2223
# AAB_WEB_PORT=4141
# CLAUDE_CODE_VERSION=latest
# CODEX_VERSION=latest
# INSTALL_CODEX=1
# INSTALL_TABPFN=1      # 0: lighter monitor image (no PyTorch), the tabular model falls back to trees
